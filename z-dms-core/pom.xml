<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-dms</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-dms-core</artifactId>
    <name>z-dms :: core</name>
    <packaging>jar</packaging>

    <description>数据源管控核心：DataSourceDef 模型 + 登记 CRUD + Druid 连接工厂 + 探活 + 变更事件</description>

    <dependencies>
        <!-- 连接池：对齐 z-boot 约定（Druid，见 z-boot ModuleDataSourceTemplate:23）。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>
        <!-- 元数据存储与数据源目标库都是 MySQL。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- 定义变更经 z-config 长连接推送 ⇒ 序列化用 Jackson。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 日志门面（探活失败必须打日志，不允许静默）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 单测夹具库：core 单测在 H2（MySQL 兼容模式）上跑，不连任何真实库；
             真实 MySQL 的验证放在 z-dms-demo-host（形态 A 端到端）。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
