<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-dms</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-dms-spring-boot-starter</artifactId>
    <name>z-dms :: spring-boot-starter</name>
    <packaging>jar</packaging>

    <description>形态 A 嵌入式 starter：宿主一行依赖引入即得数据源登记 / 连接工厂 / 探活 / z-config 推送</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-dms-core</artifactId>
        </dependency>

        <!-- Spring Boot 容器面（自动装配 + 属性绑定 + 定时探活）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 健康端点用（optional：宿主不引 web 时 starter 仍可用，只是没有 /dms/health 端点）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- actuator 健康贡献（optional）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- z-config 长连接推送通道（optional：宿主不引就不进 classpath，starter 走本地模式）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-config-client</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- z-mist 凭据解析（optional：宿主不引就走 Environment 解析器）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mist-client</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
